# Antelope docker-compose environment overrides.
#
# Copy to `.env` (same directory as docker-compose.yaml) and edit. Every value
# here is optional — the compose file falls back to the defaults shown after
# `:-`. Anything you uncomment overrides ./config.yaml at runtime.
#
#   cp .env.example .env
#   docker compose up -d --build

# ---------------------------------------------------------------------------
# Image / app
# ---------------------------------------------------------------------------
# Tag for the built image and the VERSION baked into the binary.
#ANTELOPE_VERSION=dev
# Host port mapped to the server's :8086.
#ANTELOPE_PORT=8086
# debug | release. Compose defaults to debug, which lets the stack boot with
# the placeholder secrets below (validation only warns). Set release for a real
# deployment — it fails fast unless the JWT keys, super-user password and DB
# password are real values (not the shipped placeholders).
#ANTELOPE_SYSTEM_MODE=debug
# Initial password for the seeded super-user (see system.super-user in config.yaml).
#ANTELOPE_SYSTEM_SUPER_USER_PASSWORD=password

# ---------------------------------------------------------------------------
# JWT — CHANGE THESE for any release deployment (the defaults are rejected by
# release-mode validation as known-insecure placeholders).
# ---------------------------------------------------------------------------
#ANTELOPE_JWT_ACCESS_SIGNING_KEY=antelope@access
#ANTELOPE_JWT_REFRESH_SIGNING_KEY=antelope@refresh

# ---------------------------------------------------------------------------
# PostgreSQL — consumed by both the antelope and postgres services.
# Host/port are fixed to the compose service (postgres:5432).
# ---------------------------------------------------------------------------
#POSTGRES_USER=antelope
#POSTGRES_PASSWORD=antelope
#POSTGRES_DB=antelope
#PGADMIN_PORT=5050

# ---------------------------------------------------------------------------
# Redis — leave password empty to match the default (no-auth) redis service.
# ---------------------------------------------------------------------------
#REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Nomad — EXTERNAL. Defaults reach a Nomad agent on the docker host.
# ---------------------------------------------------------------------------
#ANTELOPE_NOMAD_HOST=http://host.docker.internal
#ANTELOPE_NOMAD_PORT=4646
#ANTELOPE_NOMAD_NAMESPACE=default
#ANTELOPE_NOMAD_REGION=global
# ACL SecretID; leave empty for a no-auth (ACLs-disabled) cluster.
#ANTELOPE_NOMAD_TOKEN=

# ---------------------------------------------------------------------------
# Email — points at the bundled maildev (host/port fixed to maildev:1025).
# ---------------------------------------------------------------------------
#ANTELOPE_EMAIL_FROM=no-reply@antelope.dev
# Web UI port for inspecting captured mail.
#MAILDEV_WEB_PORT=1080

# ---------------------------------------------------------------------------
# pgAdmin — web UI for the bundled postgres. Login with the email/password
# below. If you override POSTGRES_USER/POSTGRES_PASSWORD above, also update
# ./pgadmin4/pgpass and ./pgadmin4/servers.json so the saved connection works.
# ---------------------------------------------------------------------------
#PGADMIN_PORT=5050
#PGADMIN_DEFAULT_EMAIL=admin@antelope.dev
#PGADMIN_DEFAULT_PASSWORD=pgadmin
