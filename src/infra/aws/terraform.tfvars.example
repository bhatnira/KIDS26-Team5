# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.

region   = "us-east-1"
key_name = "test-key"       # name of an existing EC2 key pair (ubuntu@ for SSH)
ssh_cidr = "0.0.0.0/0"      # lock to your office/home IP
# allowlist_ip = "0.0.0.0/0"  # CIDR allowed to reach the Nomad/Consul UIs

# Nomad cluster
# ami                  = "ami-xxxxxxxx"  # leave unset to auto-use the latest hashistack-* AMI
name_prefix          = "nomad"
server_count         = 3
client_count         = 3
server_instance_type = "t3.micro"
client_instance_type = "t3.small"

# Nextflow / S3
nextflow_bucket_name = "nextflow-CHANGE-ME"  # must be globally unique

# AWS Batch
batch_name_prefix = "nextflow"
batch_max_vcpus   = 16
# batch_instance_types      = ["optimal"]
# batch_spot_bid_percentage = 100
